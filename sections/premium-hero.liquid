{%- style -%}
  .premium-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.bg_color }};
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 6rem 0;
  }

  .premium-hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .premium-hero__container {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .premium-hero--reverse .premium-hero__container {
      grid-template-columns: 0.8fr 1.2fr;
    }

    .premium-hero--reverse .premium-hero__content {
      order: 2;
    }
  }

  .premium-hero__content {
    z-index: 2;
  }

  .premium-hero__label {
    display: inline-block;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--premium-gold-mat);
    margin-bottom: 2rem;
    font-size: 1.2rem;
  }

  .premium-hero__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 1.1;
    color: var(--premium-green-deep);
    margin: 0 0 3rem 0;
  }

  .premium-hero__text {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.8rem;
    line-height: 1.6;
    color: var(--premium-green-deep);
    opacity: 0.8;
    max-width: 50rem;
    margin-bottom: 4rem;
  }

  .premium-hero__media {
    position: relative;
    width: 100%;
  }

  .premium-hero__main-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.1);
  }

  .premium-hero__floating-image {
    position: absolute;
    bottom: -10%;
    right: -10%;
    width: 60%;
    border: 8px solid var(--premium-sand-light);
    border-radius: 4px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .premium-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    color: var(--premium-green-deep);
    border-bottom: 2px solid var(--premium-gold-mat);
    padding-bottom: 0.5rem;
    transition: all 0.3s ease;
  }

  .premium-hero__cta:hover {
    gap: 2.5rem;
    color: var(--premium-gold-mat);
  }
{%- endstyle -%}

<div class="premium-hero-{{ section.id }} premium-hero {% if section.settings.reverse %} premium-hero--reverse {% endif %}">
  <div class="page-width">
    <div class="premium-hero__container">
      <div class="premium-hero__content">
        {%- if section.settings.label != blank -%}
          <span class="premium-hero__label">{{ section.settings.label }}</span>
        {%- endif -%}

        <h2 class="premium-hero__heading">{{ section.settings.heading }}</h2>

        <div class="premium-hero__text">
          {{ section.settings.text }}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="premium-hero__cta">
            {{ section.settings.button_label }}
            <span>&rarr;</span>
          </a>
        {%- endif -%}
      </div>

      <div class="premium-hero__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag: class: 'premium-hero__main-image', loading: 'lazy'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'premium-hero__main-image' }}
        {%- endif -%}

        {%- if section.settings.image_2 != blank -%}
          {{
            section.settings.image_2
            | image_url: width: 800
            | image_tag: class: 'premium-hero__floating-image', loading: 'lazy'
          }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Premium Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image principale"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image flottante (Optionnel)"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Collection 2024",
      "label": "Sous-titre"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "La Pureté par Nature",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Découvrez une sélection exclusive de produits biologiques conçus pour votre bien-être et le respect de l'environnement.</p>",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Découvrir la collection",
      "label": "Label du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "default": false,
      "label": "Inverser la disposition"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#FAF9F6",
      "label": "Couleur de fond"
    }
  ],
  "presets": [
    {
      "name": "Premium Hero"
    }
  ]
}
{% endschema %}
